 ctx.save();

 function tracePoint(t,u){
   u=clamp(u,0,1);

   // If the target is at/before the zero distance, simply travel to the final point.
   if(!Number.isFinite(t.uZero) || t.uZero<=0 || t.uZero>=1){
     return {
       x:t.x0+(t.x1-t.x0)*u,
       y:t.y0+(t.y1-t.y0)*u
     };
   }

   // 0 -> zero time: scope bottom to the reticle's central intersection.
   if(u<=t.uZero){
     const q=u/t.uZero;
     return {
       x:t.x0+(t.xZero-t.x0)*q,
       y:t.y0+(t.yZero-t.y0)*q
     };
   }

   // After zero: central intersection to the reference-data impact point.
   const q=(u-t.uZero)/(1-t.uZero);
   return {
     x:t.xZero+(t.x1-t.xZero)*q,
     y:t.yZero+(t.y1-t.yZero)*q
   };
 }

 for(const t of traces){
   // Time is strictly normalized by the selected reference TOF.
   const u=clamp((now-t.start)/Math.max(1,t.duration),0,1);
   const head=tracePoint(t,u);
   const tailU=clamp(u-.12,0,1);
   const tail=tracePoint(t,tailU);

   // scopeAim pans the scene. Apply only the camera delta since this shot was fired,
   // so the in-flight trace remains fixed in scene/world space instead of following the reticle.
   const camDx=scopeAim.x-(Number.isFinite(t.shotScopeX)?t.shotScopeX:scopeAim.x);
   const camDy=scopeAim.y-(Number.isFinite(t.shotScopeY)?t.shotScopeY:scopeAim.y);
   head.x+=camDx; head.y+=camDy;
   tail.x+=camDx; tail.y+=camDy;

   const grad=ctx.createLinearGradient(tail.x,tail.y,head.x,head.y);
   grad.addColorStop(0,"rgba(255,210,70,0)");
   grad.addColorStop(1,"rgba(255,245,180,.95)");
   ctx.strokeStyle=grad;
   ctx.lineWidth=5;
   ctx.beginPath();ctx.moveTo(tail.x,tail.y);ctx.lineTo(head.x,head.y);ctx.stroke();

   ctx.fillStyle="rgba(255,248,200,.98)";
   ctx.beginPath();ctx.arc(head.x,head.y,6,0,Math.PI*2);ctx.fill();
 }
 ctx.restore();
}
