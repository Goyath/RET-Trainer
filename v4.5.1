(function(){
  const track=$("readySlider"),thumb=$("readyThumb");
  if(!track||!thumb)return;
  let drag=false,sx=0,pos=0;
  const max=()=>Math.max(0,track.clientWidth-thumb.clientWidth-8);
  const draw=()=>thumb.style.transform=`translateX(${Math.max(0,Math.min(max(),pos))}px)`;
  const reset=()=>{pos=0;draw()};

  function unlockStartAudio(){
    try{
      const a=$("pcslStartAudio");
      if(!a)return;
      a.volume=1.0;
      a.muted=false;
      a.currentTime=0;
      const p=a.play();
      if(p&&p.then){
        p.then(()=>{
          a.pause();
          a.currentTime=0;
        }).catch(()=>{});
      }else{
        a.pause();
        a.currentTime=0;
      }
    }catch(e){}
  }

  track.addEventListener("pointerdown",e=>{
    if(pcsl.armed||pcsl.live)return;
    // IMPORTANT: unlock the embedded WAV here, while still inside the
    // direct iPhone user gesture. Do not wait for pointerup or a timer.
    unlockStartAudio();
    drag=true;
    sx=e.clientX;
    track.setPointerCapture?.(e.pointerId);
    e.preventDefault();
  });

  track.addEventListener("pointermove",e=>{
    if(!drag)return;
    pos=e.clientX-sx;
    draw();
    e.preventDefault();
  });

  track.addEventListener("pointerup",e=>{
    if(!drag)return;
    drag=false;
    if(pos>=max()*.82){
      pos=max();
      draw();
      pcslBeginStage();
      setTimeout(reset,260);
    }else reset();
    e.preventDefault();
  });

  track.addEventListener("pointercancel",()=>{drag=false;reset()});
  window.addEventListener("resize",reset);
  reset();
})();
