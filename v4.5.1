 ctx.save();ctx.translate(cx,cy);ctx.fillStyle="#30363d";ctx.strokeStyle="#111";ctx.lineWidth=4;
 if(target.type==="plate" || target.type==="moving"){
   ctx.fillRect(-wPx/2,-hPx/2,wPx,hPx);ctx.strokeRect(-wPx/2,-hPx/2,wPx,hPx);
 } else if(target.type==="circle"){
   ctx.beginPath();ctx.arc(0,0,wPx/2,0,Math.PI*2);ctx.fill();ctx.stroke();
 } else if(target.type==="body1m"){
   // Original geometric silhouette: total height 1.00m, max shoulder width 0.50m.
   const top=-hPx/2, bottom=hPx/2;
