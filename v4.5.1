 // Short radial marks at 12 / 3 / 6 / 9 o'clock, crossing only the circle line.
 const tickHalf=(3*moaToMil)*pMil; // 6 MOA total length
 ctx.lineCap="round";
 ctx.beginPath();
 ctx.moveTo(cx,cy-ringRadiusPx-tickHalf);
 ctx.lineTo(cx,cy-ringRadiusPx+tickHalf);
 ctx.moveTo(cx+ringRadiusPx-tickHalf,cy);
 ctx.lineTo(cx+ringRadiusPx+tickHalf,cy);
 ctx.moveTo(cx,cy+ringRadiusPx-tickHalf);
 ctx.lineTo(cx,cy+ringRadiusPx+tickHalf);
 ctx.moveTo(cx-ringRadiusPx-tickHalf,cy);
 ctx.lineTo(cx-ringRadiusPx+tickHalf,cy);
 ctx.stroke();

 // 2 MOA center dot.
 ctx.beginPath();
 ctx.arc(cx,cy,centerDotRadiusPx,0,Math.PI*2);
