let impactSpeechFrames=null;
let impactVoiceNames=[null,null];

function ensureImpactSpeechFrames(){
 try{
   if(impactSpeechFrames && impactSpeechFrames.every(f=>f&&f.isConnected))return impactSpeechFrames;

   const voices=("speechSynthesis" in window)?speechSynthesis.getVoices():[];
   const english=voices.filter(v=>/^en/i.test(v.lang));
   const maleHints=/Alex|Daniel|Fred|Ralph|Tom|Aaron|Arthur|Albert|Bruce|Junior|Reed|Rocko|Eddy|Grandpa|Grandfather/i;
   const preferred=english.filter(v=>maleHints.test(v.name));
   const pool=[...preferred,...english.filter(v=>!preferred.includes(v))];
   const chosen=[];
   for(const v of pool){
     if(!chosen.some(x=>x.name===v.name))chosen.push(v);
   }
   const v2=chosen[1]||chosen[0]||null;
   const v3=chosen[2]||chosen[1]||chosen[0]||null;
   impactVoiceNames=[v2&&v2.name||null,v3&&v3.name||null];

   impactSpeechFrames=[0,1].map(()=>{
     const f=document.createElement("iframe");
     f.style.cssText="position:fixed;width:1px;height:1px;opacity:0;pointer-events:none;left:-9999px;top:-9999px";
     document.body.appendChild(f);
     return f;
   });
   return impactSpeechFrames;
 }catch(e){return null;}
}

function primeImpactSpeech(){
 try{
   const frames=ensureImpactSpeechFrames();
   if(!frames)return;
   frames.forEach(f=>{
     const w=f.contentWindow;
     if(!w||!("speechSynthesis" in w))return;
     try{
       const u=new w.SpeechSynthesisUtterance(" ");
       u.volume=0;
       u.rate=1;
       w.speechSynthesis.speak(u);
     }catch(e){}
   });
 }catch(e){}
}

function speakImpact(){
 try{
   if(!("speechSynthesis" in window))return;
   const ss=window.speechSynthesis;
   const voices=ss.getVoices();
   const english=voices.filter(v=>/^en/i.test(v.lang));
   const maleHints=/Alex|Daniel|Fred|Ralph|Tom|Aaron|Arthur|Albert|Bruce|Junior|Reed|Rocko|Eddy|Grandpa|Grandfather/i;
   const preferred=english.filter(v=>maleHints.test(v.name));
   const voice=preferred[1]||preferred[0]||english[0]||null;
   ss.cancel();
   setTimeout(()=>{
     const u=new SpeechSynthesisUtterance("Impact!");
     u.lang=(voice&&voice.lang)||"en-US";
     u.rate=.94; u.pitch=.82; u.volume=1;
     if(voice)u.voice=voice;
     ss.speak(u);
   },40);
 }catch(e){}
}
function speakMiss(){
 try{
   if(!("speechSynthesis" in window))return;
   const ss=window.speechSynthesis;
   const voices=ss.getVoices();
   const english=voices.filter(v=>/^en/i.test(v.lang));
   const maleHints=/Alex|Daniel|Fred|Ralph|Tom|Aaron|Arthur|Albert|Bruce|Junior|Reed|Rocko|Eddy|Grandpa|Grandfather/i;
   const preferred=english.filter(v=>maleHints.test(v.name));
   const voice=preferred[0]||english[0]||null;
   ss.cancel();
   setTimeout(()=>{
     const u=new SpeechSynthesisUtterance("Miss!");
     u.lang=(voice&&voice.lang)||"en-US";
     u.rate=.92; u.pitch=.82; u.volume=1;
     if(voice)u.voice=voice;
     ss.speak(u);
   },40);
 }catch(e){}
}

function animateTrace(x0,y0,xZero,yZero,x1,y1,durationMs,zeroTimeMs,onDone,shotScopeX=scopeAim.x,shotScopeY=scopeAim.y){
 const duration=Math.max(0,durationMs);
 const start=performance.now();

 // HIT/MISS timing remains tied to total TOF even when Trace is OFF.
 if($("traceDisplay").value!=="on"){
   window.setTimeout(()=>{ if(onDone)onDone(); },duration);
   return;
 }

 if(duration<=0){
   if(onDone)onDone();
   return;
 }

 const uZero=clamp((zeroTimeMs||0)/duration,0,1);
 // Freeze the shot in scene/world space at trigger time.
 // Later scope/gyro movement changes the view only; it does not steer a projectile already in flight.
 const t={x0,y0,xZero,yZero,x1,y1,uZero,start,duration,shotScopeX,shotScopeY};
 traces.push(t);

 function frame(now){
   const elapsed=now-start;
   draw();
   if(elapsed<duration){
     requestAnimationFrame(frame);
   }else{
     traces=traces.filter(v=>v!==t);
     draw();
     if(onDone)onDone();
   }
 }
 requestAnimationFrame(frame);
}
$("triggerBtn").onclick=()=>{
 try{
   if("speechSynthesis" in window){
     const ss=window.speechSynthesis;
     const u=new SpeechSynthesisUtterance(" ");
     u.volume=0;
     ss.speak(u);
   }
 }catch(e){}
 try{
   const shot=$("shotAudioEl");
   shot.volume=1;
   shot.currentTime=0;
   const pp=shot.play();
   if(pp&&pp.catch)pp.catch(()=>{});
 }catch(e){}
 unlockRETAudio();
 primeImpactSpeech();
 const r=refData();
 const p=scenePPM();
 const shotX=r.b*p;
 const shotY=r.a*p;
 // Snapshot the scope/camera position at the instant of firing.
 const shotScopeX=scopeAim.x;
 const shotScopeY=scopeAim.y;
 const feedback=$("triggerFeedback").value;
 if(!(feedback==="sound"||feedback==="both")){
   try{const a=$("shotAudioEl");a.pause();a.currentTime=0;}catch(e){}
 }
 if(feedback==="vibrate"||feedback==="both")vibrateTrigger();
 const delay=Math.max(0,r.tof*1000);
 const zero=zeroReference();

 // Visual path:
 // scope bottom -> zero point at reticle center -> final reference-data impact.
 // Total animation time always equals the selected TOF.
 const reticleCenterX=c.width/2;
 const reticleCenterY=c.height/2;
 const traceStartX=reticleCenterX;
 const traceStartY=c.height*0.94;
 const traceZeroX=reticleCenterX;
 const traceZeroY=reticleCenterY;
 const traceEndX=reticleCenterX + r.b*p;
 const traceEndY=reticleCenterY + r.a*p;

 let zeroTimeMs=0;
 if(target.range>zero.range && r.tof>0){
   zeroTimeMs=Math.min(delay,Math.max(0,zero.tof*1000));
 }else if(Math.abs(target.range-zero.range)<0.5){
   zeroTimeMs=delay;
 }

 animateTrace(traceStartX,traceStartY,traceZeroX,traceZeroY,traceEndX,traceEndY,delay,zeroTimeMs,()=>{
   // Convert the frozen shot back into the current view coordinates.
   // This cancels post-trigger MOVE SCOPE / GYRO movement while still allowing a moving target to continue moving.
   const impactShotX=shotX+(scopeAim.x-shotScopeX);
   const impactShotY=shotY+(scopeAim.y-shotScopeY);
   const hitResult=currentTargetHitAt(impactShotX,impactShotY);
   if(isPCSL() && pcsl.live){
     const zone=pcslZoneAt(impactShotX,impactShotY);
     pcsl.lastShotTime=(performance.now()-pcsl.startMs)/1000;
     pcsl.shots.push({appearance:pcsl.appearanceId,zone,time:pcsl.lastShotTime});
     updatePCSLPanel();
   }
   sessionShots++;
   if(hitResult) sessionHits++;
   updateShotStats();
   // PCSL keeps hit/zone scoring but hides green/red impact marks.
   if(!isPCSL()) hits.push({x:shotX,y:shotY,hit:hitResult});

   if(target.type==="moving"){
     const info=targetInfo();
     const wPx=(info.w/target.range)*1000*scenePPM();
     const hPx=(info.h/target.range)*1000*scenePPM();
     const nx=wPx>0 ? (impactShotX-(target.x+scopeAim.x))/wPx : 0;
     const ny=hPx>0 ? (impactShotY-(target.y+scopeAim.y))/hPx : 0;
     movingImpactMarks.push({
       nx,ny,hit:hitResult,index:movingImpactMarks.length+1
     });

     moving.shotsInCycle++;
     const mode=$("movingMode").value;
     if((mode==="normal"||mode==="hard") && moving.shotsInCycle>=2){
       nextMovingSpeed(true);
     }else{
       updateMovingReadout();
     }
   }

   draw();
   if(hitResult){
     flashHit3();
     if($("impactAudio").value==="on"){
       const acousticDelayMs=Math.max(0,(r.range/343)*1000);
       setTimeout(()=>{
         playMetalHit();
         setTimeout(()=>speakImpact(),520);
       },acousticDelayMs);
     }
   }else{
     if($("impactAudio").value==="on")speakMiss();
   }
   if(target.type==="moving"){
     $("impactReadout").textContent=(hitResult?"HIT":"MISS")+" • TOF "+r.tof.toFixed(2)+"s • speed "+moving.actualSpeed.toFixed(0)+" km/h";
   }else{
     $("impactReadout").textContent=(hitResult?"HIT":"MISS")+" • TOF "+r.tof.toFixed(2)+"s";
   }
 },shotScopeX,shotScopeY);
};


