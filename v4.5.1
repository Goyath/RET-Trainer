 if(t==="random") t=["plate","body1m","head12","torso","circle","moving"][Math.floor(Math.random()*6)];
 target.type=t;

 if(t==="moving"){
   target.range=clamp(+$("trainingRange").value||300,100,600);
 }else{
   const ar=effectiveAppearanceRange();
   const lo=Number.isFinite(ar.min)?ar.min:100;
   const hi=Number.isFinite(ar.max)?Math.max(lo,ar.max):lo;
   target.range=Math.round(lo+Math.random()*(hi-lo));
 }

 // 現出距離 always reflects the distance selected by RANDOM TARGET.
 $("range").value=String(target.range);

 target.x=(Math.random()-.5)*c.width*.25;
 target.y=(Math.random()-.5)*c.height*.18;
 draw();
}

function kmhToMph(v){return v*0.621371}
function mphToKmh(v){return v/0.621371}
function unitLabel(){return $("speedUnit").value==="mph"?"mph":"km/h"}
function displaySpeed(kmh){
 return $("speedUnit").value==="mph" ? kmhToMph(kmh) : kmh;
}
function pickRandomBaseSpeed(){
 const pool=[2,4,6,8,10];
 return pool[Math.floor(Math.random()*pool.length)];
}
function nextMovingSpeed(resetCounter=true){
 const mode=$("movingMode").value;
 const mph=$("speedUnit").value==="mph";
 if(mode==="training"){
   let entered=+$("trainingSpeed").value||4;
   entered=clamp(entered,2,10);
   moving.actualSpeed=mph ? mphToKmh(entered) : entered;
 }else{
   // Base values are native to the selected display unit:
   // km/h => 2/4/6/8/10 km/h, mph => 2/4/6/8/10 mph.
   let baseDisplay=pickRandomBaseSpeed();
   if(mode==="hard"){
     const err=+$("speedError").value||0;
     if(err>0) baseDisplay += (Math.random()*2-1)*err;
   }
   baseDisplay=clamp(baseDisplay,0.1,12);
   moving.actualSpeed=mph ? mphToKmh(baseDisplay) : baseDisplay;
 }
 if(resetCounter)moving.shotsInCycle=0;
 updateMovingReadout();
}
function configureMoving(){
 target.type="moving";
 target.range=clamp(+$("trainingRange").value||300,100,600);
 $("range").value=target.range;

 const p=$("movingPath").value;
 moving.path=p==="mixed"?(Math.random()<.5?"lateral":"diagonal"):p;
 moving.dir=Math.random()<.5?-1:1;
 moving.phase=0;
 target.x=0;target.y=0;
 movingImpactMarks=[];
 nextMovingSpeed(true);
 updateMovingReadout();
}
function updateMovingReadout(){
 const disp=displaySpeed(moving.actualSpeed);
 const decimals=$("speedUnit").value==="mph"?1:1;
 $("movingReadout").textContent=(moving.enabled?"RUNNING":"PAUSED")+
   " • "+disp.toFixed(decimals)+" "+unitLabel()+
   " • "+target.range+"m • "+moving.path+
   " • travel "+clamp(+$("travelDistance").value||10,1,500)+"m"+
   " • shots "+moving.shotsInCycle+"/2";
}
function movingStep(ts){
 if(!moving.enabled)return;
 if(!moving.lastTs)moving.lastTs=ts;
 let dt=Math.min(.05,(ts-moving.lastTs)/1000);moving.lastTs=ts;

 const mps=moving.actualSpeed/3.6;
 const milPerSec=(mps/target.range)*1000;
 const pxPerSec=milPerSec*scenePPM();

 // Physical travel span is user-selectable, end-to-end.
 // Centered on the scope, so each endpoint is ±(travel/2)m from center.
 const travelMeters=clamp(+$("travelDistance").value||10,1,500);
 const halfTravelMeters=travelMeters/2;
 const halfTravelMil=(halfTravelMeters/target.range)*1000;
 const halfTravelPx=halfTravelMil*scenePPM();

 if(moving.path==="diagonal"){
   // Keep the diagonal path length itself at 60m.
   // 45° path: x/y components are ±30/sqrt(2) m from center.
   const componentLimit=halfTravelPx/Math.sqrt(2);
   const componentSpeed=pxPerSec/Math.sqrt(2);

   target.x += moving.dir*componentSpeed*dt;
   target.y += moving.dir*componentSpeed*dt;

   if(target.x>=componentLimit || target.y>=componentLimit){
     target.x=Math.min(target.x,componentLimit);
     target.y=Math.min(target.y,componentLimit);
     moving.dir=-1;
   }else if(target.x<=-componentLimit || target.y<=-componentLimit){
     target.x=Math.max(target.x,-componentLimit);
     target.y=Math.max(target.y,-componentLimit);
     moving.dir=1;
   }
 }else{
   target.x += moving.dir*pxPerSec*dt;

   if(target.x>=halfTravelPx){
     target.x=halfTravelPx;
     moving.dir=-1;
   }else if(target.x<=-halfTravelPx){
     target.x=-halfTravelPx;
     moving.dir=1;
   }
 }

 draw();
 moving.raf=requestAnimationFrame(movingStep);
}
function startMoving(){
 if(target.type!=="moving")configureMoving();
 moving.enabled=true;moving.lastTs=0;cancelAnimationFrame(moving.raf);moving.raf=requestAnimationFrame(movingStep);updateMovingReadout();
}
function pauseMoving(){
 moving.enabled=false;cancelAnimationFrame(moving.raf);updateMovingReadout();draw();
}
