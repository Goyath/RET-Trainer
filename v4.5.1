   ctx.lineTo(headW/2,top+headH);
   ctx.lineTo(headW/2,shoulderY);
   ctx.lineTo(wPx*.32,shoulderY);
   ctx.quadraticCurveTo(wPx/2,shoulderY,wPx/2,shoulderY+hPx*.05);
   ctx.lineTo(wPx/2,bottom);
   ctx.closePath();ctx.fill();ctx.stroke();
 } else if(target.type==="torso"){
