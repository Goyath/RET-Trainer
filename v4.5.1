const pcsl={
  armed:false, live:false, startMs:0, lastShotTime:0, stageRange:null,
  shots:[], appearances:[], appearanceId:0, timer:null
};

const PCSL_STD_RANGE=[0.18,0.73,0.41,0.92,0.27,0.61,0.08,0.84,0.52,0.34,0.67,0.13,0.79,0.46,0.96,0.23,0.58,0.88,0.37,0.71];
const PCSL_STD_X=[0.22,0.78,0.38,0.66,0.14,0.86,0.47,0.29,0.71,0.55,0.91,0.33,0.62,0.18,0.74,0.43,0.82,0.26,0.57,0.69];
const PCSL_STD_Y=[0.31,0.62,0.18,0.74,0.48,0.27,0.68,0.39,0.56,0.22,0.81,0.44,0.12,0.66,0.35,0.77,0.25,0.53,0.71,0.41];
pcsl.courseIndex=0;
function pcslApplyCourse(){
  const i=((pcsl.courseIndex%20)+20)%20;
  const ar=effectiveAppearanceRange();
  pcsl.stageRange=Math.round(ar.min+(ar.max-ar.min)*PCSL_STD_RANGE[i]);
  target.type="pcsl";
  target.range=pcsl.stageRange;
  $("range").value=String(target.range);
  pcsl.appearanceId++;
  target.x=(PCSL_STD_X[i]-.5)*c.width*.34;
  target.y=(PCSL_STD_Y[i]-.5)*c.height*.24;
  draw();
}

function isPCSL(){return $("targetType") && $("targetType").value==="pcsl"}
function updatePCSLPanel(){
  const p=$("pcslPanel"); if(!p)return;
  p.classList.toggle("show",isPCSL());
  const scored=pcslScoreStage();
  $("pcslTime").textContent=(pcsl.lastShotTime||0).toFixed(2);
  $("pcslScore").textContent=String(scored.score);
  $("pcslHF").textContent=(pcsl.lastShotTime>0 ? scored.score/pcsl.lastShotTime : 0).toFixed(2);
  $("pcslK").textContent=String(scored.counts.K);
  $("pcslA").textContent=String(scored.counts.A);
  $("pcslC").textContent=String(scored.counts.C);
  $("pcslD").textContent=String(scored.counts.D);
  $("pcslShots").textContent=String(pcsl.shots.length);
}
function pcslScoreStage(){
  const groups={};
  pcsl.shots.forEach(sh=>(groups[sh.appearance]??=[]).push(sh));
  const counts={K:0,A:0,C:0,D:0}; let score=0;
  const val={K:10,A:5,C:3,D:1,M:0};
  Object.values(groups).forEach(arr=>{
    arr.sort((a,b)=>val[b.zone]-val[a.zone]);
    arr.slice(0,2).forEach(sh=>{score+=val[sh.zone]; if(counts[sh.zone]!=null)counts[sh.zone]++;});
  });
  return {score,counts};
}
function pcslSpeak(text){
  try{
    speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(text);
    u.lang="en-US";
    u.rate=.88;
    u.pitch=.82;
    u.volume=1.0;
    const voices=speechSynthesis.getVoices();
    const preferred=[
      "Aaron","Alex","Daniel","Fred","Ralph","Reed","Rocko","Sandy","Shelley",
      "Eddy","Grandpa","Albert"
    ];
    let v=null;
    for(const name of preferred){
      v=voices.find(x=>x.lang&&x.lang.toLowerCase().startsWith("en-us")&&x.name.includes(name));
      if(v)break;
    }
    if(!v) v=voices.find(x=>x.lang&&x.lang.toLowerCase().startsWith("en-us"));
    if(v)u.voice=v;
    speechSynthesis.speak(u);
  }catch(e){}
}
let pcslAudioCtx=null;
function ensurePCSLAudio(){
  try{
    if(!pcslAudioCtx)pcslAudioCtx=new (window.AudioContext||window.webkitAudioContext)();
    if(pcslAudioCtx.state==="suspended")pcslAudioCtx.resume();
  }catch(e){}
}
function pcslBuzzer(){
  try{
    const a=$("pcslStartAudio");
    if(!a)return;
    a.pause(); a.currentTime=0; a.volume=1.0;
    const p=a.play();
    if(p&&p.catch)p.catch(()=>{});
  }catch(e){}
}
function pcslNewAppearance(){
  pcsl.appearanceId++;
  target.x=(Math.random()-.5)*c.width*.34;
  target.y=(Math.random()-.5)*c.height*.24;
  if(pcsl.stageRange!=null){target.range=pcsl.stageRange; $("range").value=String(target.range)}
  draw();
}
function pcslResetStage(){
  if(pcsl.timer){clearTimeout(pcsl.timer);pcsl.timer=null}
  pcsl.armed=false; pcsl.live=false; pcsl.startMs=0; pcsl.lastShotTime=0;
  pcsl.shots=[]; pcsl.appearances=[]; pcsl.appearanceId=0; pcsl.stageRange=null; pcsl.courseIndex=0;
  $("readySlider").classList.remove("armed","live");
  $("pcslStatus").textContent="PCSL READY";
  updatePCSLPanel();
}
function pcslBeginStage(){
  if(!isPCSL())return;
  ensurePCSLAudio();
  try{
    const a=$("pcslStartAudio");
    if(a){
      a.volume=1.0;
      const p=a.play();
      if(p&&p.then)p.then(()=>{a.pause();a.currentTime=0}).catch(()=>{});
    }
  }catch(e){}
  if(pcsl.timer){clearTimeout(pcsl.timer);pcsl.timer=null}
  pcsl.armed=true; pcsl.live=false; pcsl.startMs=0; pcsl.lastShotTime=0;
  pcsl.shots=[]; pcsl.appearances=[]; pcsl.appearanceId=0;

  pcsl.courseIndex=0;
  pcslApplyCourse();

  $("readySlider").classList.add("armed"); $("readySlider").classList.remove("live");
  $("pcslStatus").textContent="READY";
  updatePCSLPanel();

  // Slide completed: wait 0.5 s before the first spoken command.
  try{speechSynthesis.cancel()}catch(e){}
  setTimeout(()=>{
    if(!pcsl.armed)return;
    $("pcslStatus").textContent="READY SEQUENCE";
    pcslSpeak("Are you ready?");

    // Then speak Stand by as a separate command.
    setTimeout(()=>{
      if(!pcsl.armed)return;
      $("pcslStatus").textContent="READY SEQUENCE";
      pcslSpeak("Stand by.");

      // After Stand by, use a clean random 3–5 s silent interval.
      setTimeout(()=>{
        if(!pcsl.armed)return;
        const silentDelay=3000+Math.random()*2000;
        pcsl.timer=setTimeout(()=>{
          if(!pcsl.armed)return;
          try{speechSynthesis.cancel()}catch(e){}
          pcsl.armed=false; pcsl.live=true; pcsl.startMs=performance.now();
          $("readySlider").classList.remove("armed"); $("readySlider").classList.add("live");
          $("pcslStatus").textContent="LIVE";
          pcslBuzzer();
        },silentDelay);
      },1100);
    },1300);
  },500);
}


let activeCustomKey=null;

function currentTableRows(){
  return Array.from($("body").querySelectorAll("tr")).map(tr=>{
    const inp=tr.querySelectorAll("input");
    return inp.length>=4 ? [inp[0].value,inp[1].value,inp[2].value,inp[3].value] : null;
  }).filter(Boolean);
}

function setReferenceRows(rows){
  const tb=$("body"); tb.innerHTML="";
  rows.forEach(r=>{
    const tr=document.createElement("tr");
    r.forEach((v,i)=>{
      const td=document.createElement("td"), input=document.createElement("input");
      input.type="number";
      input.step=i===0?"1":"0.01";
      input.className=["x","a","b","tof"][i];
      input.value=(typeof v==="number"&&i>0)?Number(v).toFixed(2):v;
      td.appendChild(input); tr.appendChild(td);
    });
    tb.appendChild(tr);
  });
}

function getCustomProfiles(){
  try{ return JSON.parse(localStorage.getItem("RET_CUSTOM_GUN_PROFILES")||"{}"); }
  catch(e){ return {}; }
}
function saveCustomProfiles(obj){
  localStorage.setItem("RET_CUSTOM_GUN_PROFILES",JSON.stringify(obj));
}
function refreshGunProfileOptions(selectValue){
  const sel=$("gunProfile");
  const customs=getCustomProfiles();
  sel.innerHTML="";
  [
    ["swissp","Swiss P 165gr"],
    ["556_nas3_805_13","5.56mm 80.5gr NAS3 13in"],
    ["300wm_220_26","300WM 220gr 26in"],
    ["556_15_25","5.56mm 1.5in 25mZero"],
    ["556_15_50","5.56mm 1.5in 50mZero"],
    ["556_226_25","5.56mm 2.26in 25mZero"],
    ["556_226_50","5.56mm 2.26in 50mZero"],
    ["556_hydra_25","5.56mm Hydra 25mZero"],
    ["556_hydra_50","5.56mm Hydra 50mZero"],
    ["custom_new","CUSTOM"]
  ].forEach(([v,t])=>{
    const o=document.createElement("option");o.value=v;o.textContent=t;sel.appendChild(o);
  });
  Object.keys(customs).forEach(k=>{
    const o=document.createElement("option");
    o.value="custom:"+k;
    o.textContent=customs[k].name||k;
    sel.appendChild(o);
  });
  if(selectValue && Array.from(sel.options).some(o=>o.value===selectValue)) sel.value=selectValue;
}

function clearReferenceRows(){
  $("body").innerHTML="";
  for(let i=0;i<8;i++){
    const tr=document.createElement("tr");
    [0,1,2,3].forEach((_,j)=>{
      const td=document.createElement("td"),input=document.createElement("input");
      input.type="number";input.step=j===0?"1":"0.01";
      input.className=["x","a","b","tof"][j];
      input.value="";
      td.appendChild(input);tr.appendChild(td);
    });
    $("body").appendChild(tr);
  }
}

