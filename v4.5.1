// GYRO AIM control wiring — intentionally inside the main RET Trainer scope.
(function bindGyroAimControl(){
 const b=$("gyroAimBtn");
 if(!b)return;
 gyroAimLabel();
 let firedAt=0;
 const fire=(e)=>{
   const now=Date.now();
   if(now-firedAt<450)return;
   firedAt=now;
   if(e&&e.cancelable)e.preventDefault();
   const turningOn=!gyroAim.enabled;
   b.textContent=turningOn?"GYRO AIM ON":"GYRO AIM OFF";
   b.classList.toggle("gyro-on",turningOn);
   b.classList.toggle("gyro-off",!turningOn);
   gyroDiag(turningOn?"button pressed • starting…":"button pressed • stopping…");
   toggleGyroAim();
 };
 if(window.PointerEvent){
   b.addEventListener("pointerup",fire,{passive:false});
 }else{
   b.addEventListener("touchend",fire,{passive:false});
   b.addEventListener("click",fire,false);
 }
})();

})();




