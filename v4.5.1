 const moaToMil=0.290888;

 const ringRadiusPx=(32.5*moaToMil)*pMil;          // 65 MOA diameter
 const ringWidthPx=Math.max(1,(2*moaToMil)*pMil); // 2 MOA angular thickness
 const centerDotRadiusPx=Math.max(1,(1*moaToMil)*pMil);   // 2 MOA diameter
