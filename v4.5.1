<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>RET Trainer CIV v3.0 RANGE DISPLAY FIX</title>
<style>
:root{color-scheme:dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:#0b0f14;color:#eef2f6;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.wrap{max-width:980px;margin:auto;padding:14px}
h1{font-size:22px;margin:0 0 12px}
.card{background:#151b23;border:1px solid #34404d;border-radius:16px;padding:14px;margin-bottom:14px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
button,input,select{font:inherit;border-radius:10px;border:1px solid #465362;background:#0e141b;color:#eef2f6;padding:10px}
button{min-height:44px}
button.primary{background:#2453a6}
.bigTrigger{
  min-width:190px;
  min-height:72px;
  padding:16px 30px;
  font-size:24px;
  font-weight:800;
  letter-spacing:.06em;
  border-width:2px;
}
.bigTrigger:active{transform:scale(.97)}
@media(max-width:700px){
  .bigTrigger{
    flex:1 1 100%;
    width:100%;
    min-height:86px;
    font-size:28px;
  }
}
button.active{background:#345f35;border-color:#5e9a5e}
label{font-size:13px;color:#b8c3ce;display:block}
input,select{width:100%;margin-top:4px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.scope{position:relative;width:100%;aspect-ratio:1/1;background:#cfc8b5;border:8px solid #030609;border-radius:50%;overflow:hidden;touch-action:none;user-select:none}
canvas{width:100%;height:100%;display:block}
.badge{position:absolute;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.55);padding:5px 10px;border-radius:12px;font-size:12px;white-space:pre-line;text-align:center;line-height:1.25;pointer-events:none}
.top{top:14px}.bottom{bottom:14px}
.hint{font-size:12px;color:#9ca9b7;margin-top:8px}
#reticleStatus{font-size:13px;color:#9fe0b0;margin:8px 0 0}
table{width:100%;border-collapse:collapse}
th,td{padding:6px;border-bottom:1px solid #34404d}
.small{font-size:12px;color:#9ca9b7}
.scroll{overflow:auto}
.modeBar{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px}
.modeBar button{width:100%}
.calibScope{position:relative;width:100%;aspect-ratio:1/1;background:#d1cbb8;border:1px solid #465362;border-radius:14px;overflow:hidden;touch-action:none;margin-top:10px}
#calibCanvas{width:100%;height:100%;display:block}
.calibActions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.notice{border:1px solid #465362;background:#0f151d;border-radius:10px;padding:10px;font-size:12px;color:#c1ccd7}
@media(max-width:700px){
  .grid{grid-template-columns:1fr}
  .modeBar{grid-template-columns:1fr 1fr}
  .calibActions{grid-template-columns:1fr 1fr}
}
@media (orientation:landscape) and (min-width:760px){
  .wrap{max-width:1500px;padding:10px}
  .simCard{
    display:grid;
    grid-template-columns:minmax(520px,1.45fr) minmax(390px,.9fr);
    grid-template-rows:auto auto auto auto auto 1fr;
    gap:10px 16px;
    align-items:start;
  }
  .simCard > .scope{
    grid-column:1;
    grid-row:1 / span 6;
    width:min(78vh,100%);
    justify-self:center;
    align-self:start;
  }
  .simCard > .modeBar,
  .simCard > .hint,
  .simCard > .row,
  .simCard > #impactReadout,
  .simCard > .grid,
  .simCard > .card{
    grid-column:2;
    margin-top:0 !important;
  }
  .simCard > .modeBar{grid-row:1}
  .simCard > .hint{grid-row:2}
  .simCard > .row{grid-row:3}
  .simCard > #impactReadout{grid-row:4}
  .simCard > .grid{grid-row:5}
  .simCard > .card{grid-row:6}
  h1{font-size:18px;margin-bottom:8px}
  .card{padding:10px}
  .bigTrigger{min-height:78px;font-size:28px}
}

.statsReset{
  flex:1 1 260px;
  display:flex;
  align-items:stretch;
  justify-content:flex-end;
  gap:8px;
  min-width:0;
}
.shotStats{
  flex:1 1 auto;
  min-width:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:7px 10px;
  border:1px solid #475569;
  border-radius:12px;
  background:#0b1118;
  color:#f8fafc;
  line-height:1.2;
  white-space:nowrap;
}
.shotStats .statsMain{font-size:15px;font-weight:700}
.shotStats .statsSub{font-size:13px;color:#aeb8c5;margin-top:3px}
#statsResetBtn{
  flex:0 0 auto;
  min-width:96px;
  padding:10px 14px;
}
@media(max-width:700px){
  .statsReset{flex:1 1 48%;gap:6px}
  .shotStats{padding:6px 7px}
  .shotStats .statsMain{font-size:13px}
  .shotStats .statsSub{font-size:12px}
  #statsResetBtn{min-width:82px;padding:8px 10px;font-size:13px}
}


#readyBtn{min-width:150px}
#pcslResetBtn{min-width:110px}
#readyBtn.armed{background:#7c2d12;border-color:#fb923c;color:#fff}
#readyBtn.live{background:#991b1b;border-color:#f87171;color:#fff}
.pcslPanel{
  margin-top:10px;padding:10px 12px;border:1px solid #475569;border-radius:12px;
  background:#0b1118;color:#f8fafc;display:none;
}
.pcslPanel.show{display:block}
.pcslTop{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.pcslResult{font-weight:800;font-size:16px}
.pcslZones{font-size:14px;color:#cbd5e1;margin-top:4px}
.pcslStatus{font-size:13px;color:#93c5fd;margin-top:4px}
@media(max-width:700px){#readyBtn{min-width:120px}#pcslResetBtn{min-width:96px}.pcslResult{font-size:14px}.pcslZones{font-size:12px}}
.readySlider{position:relative;width:190px;height:52px;border:1px solid #53616d;border-radius:14px;background:#111820;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;flex:0 0 auto}.readyTrackText{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding-left:42px;font-weight:800;font-size:13px;letter-spacing:.8px;color:#aeb8c1;pointer-events:none}.readyThumb{position:absolute;left:4px;top:4px;width:44px;height:44px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;background:#293743;color:#eaf2f8;box-shadow:0 1px 5px #0008;transform:translateX(0);will-change:transform;pointer-events:none}.readySlider.armed{border-color:#d49a28}.readySlider.live{border-color:#39c46a}.readySlider.armed .readyTrackText{color:#d49a28}.readySlider.live .readyTrackText{color:#39c46a}@media(max-width:700px){.readySlider{width:176px;height:52px}}</style>
<script defer src="https://cloud.umami.is/script.js" data-website-id="50505501-aabb-4e0f-96ab-ce22742cdc33"></script>

<style id="gyroAimStateStyle">
#gyroAimBtn{
  transition:background-color .12s ease,border-color .12s ease,color .12s ease,transform .08s ease;
}
#gyroAimBtn.gyro-off{
  background:#111820;
  border-color:#596879;
  color:#dce4ec;
}
#gyroAimBtn.gyro-on{
  background:#236b38;
  border-color:#42df73;
  color:#ffffff;
  box-shadow:0 0 0 1px rgba(66,223,115,.22) inset;
}
#gyroAimBtn:active{transform:scale(.97);}
</style>
</head>
<body>
<audio id="pcslStartAudio" preload="auto" playsinline src="data:audio/wav;base64,"></audio>
<audio id="shotAudioEl" preload="auto" playsinline src="data:audio/wav;base64,"></audio>
<audio id="hitAudioEl" preload="auto" playsinline src="data:audio/wav;base64,"></audio>
<div class="wrap">
<h1>RET Trainer CIV v4.5</h1>

<div class="card simCard">
  <div id="scope" class="scope">
    <canvas id="scopeCanvas" width="1000" height="1000"></canvas>
    <div class="badge top" id="targetText">1m steel / 300m</div>
    <div class="badge bottom" id="zoomText">10.0× FFP</div>
  </div>

  <div class="modeBar">
    <button id="reticleMove" class="active">MOVE SCOPE</button>
    <button id="targetMove">MOVE TARGET</button>
    <button id="backgroundMove">MOVE BACKGROUND</button>
    <button id="clearHits">CLEAR HITS</button>
  </div>
  <div class="hint">1本指：選択中を移動　／　2本指ピンチ：倍率変更（BACKGROUND選択時は背景の拡大縮小）　／　背景・ターゲット・レチクルは独立して動かせます。</div>

  <div class="row" style="margin-top:10px">
    <button id="randomBtn" class="primary">RANDOM TARGET</button>
    <div class="statsReset">
      <div class="shotStats" id="shotStats">
        <div class="statsMain">SHOTS <span id="totalShots">0</span></div>
        <div class="statsSub">HIT RATE <span id="hitRate">0.0%</span></div>
      </div>
      <button id="statsResetBtn">RESET</button>
    </div>
    <button id="triggerBtn" class="bigTrigger">TRIGGER</button>
    <button id="recenterBtn">RECENTER</button>
      <button id="gyroAimBtn" class="secondary" style="font-size:14px;padding:10px 12px;min-height:44px">GYRO AIM OFF</button>
      <div id="gyroDiag" style="font-size:11px;line-height:1.35;color:#9aa7b6;max-width:240px;padding:4px 2px">
        GYRO: not checked
      </div>
    <div id="readySlider" class="readySlider"><div class="readyTrackText">SLIDE TO READY</div><div id="readyThumb" class="readyThumb">▶</div></div>
    <button id="pcslResetBtn">RESET</button>
  </div>
  <div id="pcslPanel" class="pcslPanel">
    <div class="pcslTop">
      <div class="pcslResult">TIME <span id="pcslTime">0.00</span>s &nbsp; SCORE <span id="pcslScore">0</span> &nbsp; HF <span id="pcslHF">0.00</span></div>
    </div>
    <div class="pcslZones">K×<span id="pcslK">0</span> &nbsp; A×<span id="pcslA">0</span> &nbsp; C×<span id="pcslC">0</span> &nbsp; D×<span id="pcslD">0</span> &nbsp; SHOTS <span id="pcslShots">0</span></div>
    <div class="pcslStatus" id="pcslStatus">PCSL READY</div>
  </div>

  <div class="grid" style="margin-top:10px">
    <label>最小距離
      <div style="display:flex;align-items:center;gap:6px"><input id="minRange" type="number" min="1" max="5000" value="150" step="1" style="flex:1"><span>m</span></div>
    </label>
    <label>最大距離
      <div style="display:flex;align-items:center;gap:6px"><input id="maxRange" type="number" min="1" max="800" value="800" step="1" style="flex:1"><span>m</span></div>
    </label>
    <label>Target
      <select id="targetType">
        <option value="plate">1m steel plate</option>
        <option value="body1m">1m Body 0.50m wide</option>
        <option value="head12">12in Head-to-Shoulder / Chest</option>
        <option value="torso">12in diamond</option>
        <option value="circle">12in circle</option>
        <option value="moving">Moving steel 1.0m × 0.30m</option>
        <option value="random">Random</option>
        <option value="pcsl">PCSL K-Zone Target</option>
</select>
    </label>
    <label>現出距離
      <input id="range" type="number" value="300" min="1" max="5000" title="手入力した距離で現出。RANDOM TARGET時は最小距離〜最大距離から選択">
    </label>
    <div class="small" style="grid-column:1/-1">
      現出距離＝手入力した任意距離。RANDOM TARGET＝最小距離〜最大距離の範囲からランダム現出。
      ランダム選択後の距離は現出距離欄へ自動反映されます。
    </div>
    <label>Min zoom
      <input id="minZoom" type="number" value="5">
    </label>
    <label>Max zoom
      <input id="maxZoom" type="number" value="42">
    </label>
    <label>FFP / SFP
      <select id="fp"><option value="FFP">FFP</option><option value="SFP">SFP</option></select>
    </label>
    <label>SFP calibration zoom
      <input id="sfpCal" type="number" value="10" step="0.1">
    </label>
    <label>LRF画面
      <select id="showLRF">
        <option value="on" selected>ON</option>
        <option value="off">OFF</option>
      </select>
    </label>
    <label>ドロップ量表示
      <select id="showDrop">
        <option value="on">ON</option>
        <option value="off" selected>OFF</option>
      </select>
    </label>
    <label>Trigger feedback
      <select id="triggerFeedback">
        <option value="sound" selected>発射音</option>
        <option value="vibrate">バイブ</option>
        <option value="both">発射音＋バイブ</option>
        <option value="off">OFF</option>
      </select>
    </label>
    <label>Hit / Miss audio
      <select id="impactAudio">
        <option value="on" selected>ON</option>
        <option value="off">OFF</option>
      </select>
    </label>
    <label>Trace display
      <select id="traceDisplay">
        <option value="on" selected>ON</option>
        <option value="off">OFF</option>
      </select>
    </label>
    <label>Background image
      <input id="backgroundFile" type="file" accept="image/png,image/jpeg,image/webp">
    </label>
    <label>Background scale
      <input id="backgroundScale" type="number" value="1.00" min="1" max="5" step="0.05">
    </label>
  </div>
  <div class="row" style="margin-top:8px">
    <button id="defaultBackground">DEFAULT MOUNTAIN</button>
    <button id="resetBackground">RESET BACKGROUND</button>
    <span id="backgroundStatus" class="small">Default mountain loaded</span>
  </div>
  <div id="vibrationStatus" class="small" style="margin-top:8px"></div>

  <div class="card" style="margin-top:12px;background:#10161d">
    <b>Moving target settings</b>
    <p class="small">Moving target is 1.0m high × 0.30m wide. Travel distance can be set in meters. Distance stays fixed during the drill. Normal / Hard change speed after every 2nd impact.</p>
    <div class="grid">
      <label>Mode
        <select id="movingMode">
          <option value="training">Training</option>
          <option value="normal" selected>Normal</option>
          <option value="hard">Hard</option>
        </select>
      </label>
      <label>Speed unit
        <select id="speedUnit">
          <option value="kmh" selected>km/h</option>
          <option value="mph">mph</option>
        </select>
      </label>
      <label>Path
        <select id="movingPath">
          <option value="lateral">Lateral back-and-forth only</option>
          <option value="mixed">Include diagonal</option>
          <option value="diagonal">Diagonal only</option>
        </select>
      </label>
      <label>Hard speed error
        <select id="speedError">
          <option value="0" selected>OFF</option>
          <option value="1">±1 km/h</option>
          <option value="2">±2 km/h</option>
        </select>
      </label>
      <label>Fixed range (100–600m)
        <input id="trainingRange" type="number" min="100" max="600" value="300" step="1">
      </label>
      <label>Travel distance
        <div style="display:flex;align-items:center;gap:6px">
          <input id="travelDistance" type="number" min="1" max="500" value="10" step="1" style="flex:1">
          <span>m</span>
        </div>
      </label>
      <label>Training speed
        <input id="trainingSpeed" type="number" min="2" max="10" value="4" step="0.1">
      </label>
    </div>
    <div class="row" style="margin-top:10px">
      <button id="startMoving" class="primary">START MOVING</button>
      <button id="pauseMoving">PAUSE</button>
      <span id="movingReadout" class="small">Stopped</span>
    </div>
    <div class="small" style="margin-top:8px">
      Training：指定速度を維持。Normal：選択単位で2 / 4 / 6 / 8 / 10からランダム。Hard：NormalにOFF / ±1 / ±2（選択単位）の誤差を追加。Normal / Hardは2発目の着弾後に次の速度へ変更。可動距離は「○m」で任意設定できます。
    </div>
    <div class="small" style="margin-top:6px">Moving Targetでは着弾位置をターゲット座標に記録します。的が動き続けても、命中箇所に番号付きマーカーが追従します。</div>
  </div>
</div>

<div class="card">
  <b>Custom reticle image</b>
  <p class="small">画像調整を別画面化しました。画像を読み込んだあと、下の調整画面で1本指ドラッグ／2本指ピンチで合わせます。固定の赤線間が20milです。</p>
  <div class="row">
    <input id="reticleFile" type="file" accept="image/png,image/jpeg,image/webp">
    <button id="clearReticle">画像解除</button>
  </div>
  <div id="reticleStatus">画像未選択</div>

  <div class="calibScope" id="calibScope">
    <canvas id="calibCanvas" width="900" height="900"></canvas>
  </div>
  <div class="calibActions">
    <button id="smaller">− SCALE</button>
    <button id="larger">＋ SCALE</button>
    <button id="centerImg">CENTER</button>
    <button id="useCustom" class="primary">USE RETICLE</button>
  </div>

  <div class="grid" style="margin-top:10px">
    <label>Reticle mode
      <select id="reticleMode">
        <option value="classic">Classic 0.2mil</option>
        <option value="moa68" selected>68 MOA ring / 1 MOA dot</option>
        <option value="fourDot65">4-dot circle 65 MOA</option>
        <option value="dot2moa">2 MOA Red Dot</option>
        <option value="custom">Custom image</option>
      </select>
    </label>
    <label>Opacity
      <input id="opacity" type="range" min="10" max="100" value="90">
    </label>
    <label>Current zoom
      <input id="zoomNumber" type="number" value="10" step="0.1">
    </label>
    <label>Image scale
      <input id="scaleNumber" type="number" value="1.00" step="0.01">
    </label>
  </div>
</div>

<div class="card">
  <b>Save / Restore</b>
  <div class="row" style="margin-top:10px">
    <button id="saveProfile" class="primary">SAVE PROFILE</button>
    <button id="loadProfile">LOAD SAVED</button>
    <button id="deleteProfile">DELETE SAVED</button>
  </div>
  <div id="saveStatus" class="small" style="margin-top:8px">レチクル画像・背景画像・入力テーブル・主要設定をこのブラウザ内に保存します。</div>
</div>

<div class="card" style="margin-top:12px">
    <b>GUN DATA</b>
    <div class="grid" style="margin-top:8px">
      <label>Profile
        <select id="gunProfile">
          <option value="swissp" selected>Swiss P 165gr</option>
          <option value="556_nas3_805_13">5.56mm 80.5gr NAS3 13in</option>
          <option value="556_15_25">5.56mm 1.5in 25mZero</option>
          <option value="556_15_50">5.56mm 1.5in 50mZero</option>
          <option value="556_226_25">5.56mm 2.26in 25mZero</option>
          <option value="556_226_50">5.56mm 2.26in 50mZero</option>
          <option value="556_hydra_25">5.56mm Hydra 25mZero</option>
          <option value="556_hydra_50">5.56mm Hydra 50mZero</option>
          <option value="custom_new">CUSTOM</option>
        </select>
      </label>
    </div>
    <div id="gunProfileInfo" class="small" style="margin-top:6px">Swiss P 165gr</div>

    <div id="customProfilePanel" style="display:none;margin-top:10px">
      <div class="grid">
        <label>Profile name
          <input id="customProfileName" type="text" placeholder="e.g. 5.56mm custom profile / 50m Zero">
        </label>
        <label>Zero Setting
          <div style="display:flex;align-items:center;gap:6px">
            <input id="customZeroSetting" type="number" min="1" max="2000" value="100" step="1" style="flex:1">
            <span>m</span>
          </div>
        </label>
      </div>
      <div class="row" style="margin-top:8px">
        <button id="saveCustomProfile" class="primary">SAVE CUSTOM</button>
        <button id="renameCustomProfile">RENAME</button>
        <button id="deleteCustomProfile">DELETE</button>
      </div>
      <div class="small" style="margin-top:6px">
        Reference table below can be edited manually: Range / Drop / Spin Drift / TOF.
      </div>
    </div>
  </div>
<div class="card">
  <div class="row" style="justify-content:space-between">
    <div><b>Reference table</b><div class="small">Range / Drop / Spin Drift / TOF。初期データは指定された100〜1500m・50m刻みの表を登録済みです。</div></div>
    <div class="row">
      <button id="addTop" class="primary">＋ 行追加</button>
      <button id="sample">Sample</button>
      <button id="clearTable">Clear</button>
    </div>
  </div>
  <div class="scroll">
    <table>
      <thead><tr><th>Range (m)</th><th>Drop (MRAD)</th><th>Spin Drift (MRAD)</th><th>TOF (s)</th><th></th></tr></thead>
      <tbody id="body"></tbody>
    </table>
  </div>
</div>
</div>

<script>
const tremor3Img=new Image();
tremor3Img.src="data:image/png;base64,";
(function(){
const $=id=>document.getElementById(id);
const scope=$("scope"), c=$("scopeCanvas"), ctx=c.getContext("2d");
const calibScope=$("calibScope"), cc=$("calibCanvas"), cctx=cc.getContext("2d");

let reticle=null;
let reticleDataURL="";
let backgroundDataURL="";
let reticleScale=1;
let reticleImgOffset={x:0,y:0};

const DEFAULT_BG = "data:image/jpeg;base64,";
let backgroundImg=new Image();
let backgroundReady=false;
let backgroundScale=1;
let backgroundOffset={x:0,y:0};
backgroundImg.onload=()=>{backgroundReady=true;draw();};
backgroundDataURL=DEFAULT_BG;
backgroundImg.src=DEFAULT_BG;
let target={type:"plate",range:300,x:0,y:0};
let reticlePos={x:0,y:0}; // retained for saved-profile compatibility; optical reticle is fixed
let scopeAim={x:0,y:0};
let hits=[];
let movingImpactMarks=[];
let traces=[];
let hitFlashOn=false;
let hitFlashTimer=null;
let moveMode="scope";
let zoom=10;

let moving={
  enabled:false,
  actualSpeed:0,      // internally always km/h
  dir:1,
