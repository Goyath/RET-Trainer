function unlockRETAudio(){
 try{
   const hit=document.getElementById("hitAudioEl");
   if(!hit)return;
   const oldVol=hit.volume;
   hit.volume=0;
   const p=hit.play();
   if(p&&p.then){
     p.then(()=>{
       hit.pause();
       try{hit.currentTime=0;}catch(e){}
       hit.volume=oldVol||1;
     }).catch(()=>{hit.volume=oldVol||1;});
   }
 }catch(e){}
}
