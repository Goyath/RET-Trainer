let gyroAim={
 enabled:false,baseBeta:null,baseGamma:null,baseX:0,baseY:0,
 eventCount:0,absCount:0,motionCount:0,probe:null,lastSource:"",motionX:0,motionY:0,lastMotionTs:null,motionBaseX:0,motionBaseY:0
};
function gyroDiag(text){
 const d=$("gyroDiag"); if(d)d.textContent="GYRO: "+text;
}
function gyroAimLabel(){
 const b=$("gyroAimBtn"); if(!b)return;
 b.textContent=gyroAim.enabled?"GYRO AIM ON":"GYRO AIM OFF";
 b.classList.toggle("gyro-on",gyroAim.enabled);
 b.classList.toggle("gyro-off",!gyroAim.enabled);
}
function applyOrientation(beta,gamma,source){
 if(!gyroAim.enabled||beta==null||gamma==null)return;
 if(gyroAim.baseBeta==null){
   gyroAim.baseBeta=beta; gyroAim.baseGamma=gamma;
   gyroAim.baseX=scopeAim.x; gyroAim.baseY=scopeAim.y;
 }
 const mag=Math.max(1,Number($("mag").value)||1), pxPerDeg=3*mag;
 let dg=gamma-gyroAim.baseGamma, db=beta-gyroAim.baseBeta;
 if(dg>180)dg-=360;if(dg<-180)dg+=360;
 if(db>180)db-=360;if(db<-180)db+=360;
 scopeAim.x=gyroAim.baseX-dg*pxPerDeg;
 scopeAim.y=gyroAim.baseY-db*pxPerDeg;
 gyroAim.lastSource=source;
 gyroDiag("ACTIVE "+source+" • β "+beta.toFixed(1)+"° γ "+gamma.toFixed(1)+"°");
 draw();
}
function gyroOrientation(e){
 gyroAim.eventCount++;
 applyOrientation(e.beta,e.gamma,"orientation");
}
function gyroOrientationAbsolute(e){
 gyroAim.absCount++;
 // Use absolute orientation only if normal orientation has not started.
 if(gyroAim.eventCount===0)applyOrientation(e.beta,e.gamma,"absolute");
}
function gyroMotion(e){
 gyroAim.motionCount++;
 // Keep the v3.9 receiver path; only turn each received motion event into live scene movement.
 if(!gyroAim.enabled)return;
 const rr=e.rotationRate;
 if(!rr){
   gyroDiag("MOTION event received");
   return;
 }

 const now=(typeof e.timeStamp==="number"&&e.timeStamp>0)?e.timeStamp:performance.now();
 if(gyroAim.lastMotionTs==null){
   gyroAim.lastMotionTs=now;
   gyroAim.motionX=0; gyroAim.motionY=0;
   gyroAim.motionBaseX=scopeAim.x; gyroAim.motionBaseY=scopeAim.y;
 }

 let dt=(now-gyroAim.lastMotionTs)/1000;
 gyroAim.lastMotionTs=now;
 if(!Number.isFinite(dt)||dt<=0||dt>.20)dt=0;

 // Integrate the same rotationRate values v3.9 was displaying.
 const rx=Number(rr.beta)||0;
 const ry=Number(rr.alpha)||0;
 const dead=0.20;
 if(dt>0){
   gyroAim.motionX+=(Math.abs(rx)<dead?0:rx)*dt;
   gyroAim.motionY+=(Math.abs(ry)<dead?0:ry)*dt;
 }

 // Fixed moderate visual sensitivity for the first live test.
 const pxPerDeg=12;
 scopeAim.x=gyroAim.motionBaseX-gyroAim.motionX*pxPerDeg;
 scopeAim.y=gyroAim.motionBaseY-gyroAim.motionY*pxPerDeg;

 const aa=rr.alpha==null?"—":Number(rr.alpha).toFixed(1);
 const bb=rr.beta==null?"—":Number(rr.beta).toFixed(1);
 const gg=rr.gamma==null?"—":Number(rr.gamma).toFixed(1);
 gyroDiag("LIVE MOTION • α "+aa+" β "+bb+" γ "+gg+" • X "+gyroAim.motionX.toFixed(1)+" Y "+gyroAim.motionY.toFixed(1));
 draw();
}
function removeGyroListeners(){
 window.removeEventListener("deviceorientation",gyroOrientation,true);
 window.removeEventListener("deviceorientationabsolute",gyroOrientationAbsolute,true);
 window.removeEventListener("devicemotion",gyroMotion,true);
}
function startGyroListeners(){
 gyroAim.enabled=true;
 gyroAim.baseBeta=null;gyroAim.baseGamma=null;
 gyroAim.eventCount=0;gyroAim.absCount=0;gyroAim.motionCount=0;gyroAim.lastSource="";
 gyroAim.motionX=0;gyroAim.motionY=0;gyroAim.lastMotionTs=null;gyroAim.motionBaseX=scopeAim.x;gyroAim.motionBaseY=scopeAim.y;
 removeGyroListeners();
 window.addEventListener("deviceorientation",gyroOrientation,true);
 window.addEventListener("deviceorientationabsolute",gyroOrientationAbsolute,true);
 window.addEventListener("devicemotion",gyroMotion,true);
 gyroAimLabel();
 gyroDiag("ON • waiting: orientation / absolute / motion…");
 clearTimeout(gyroAim.probe);
 gyroAim.probe=setTimeout(()=>{
   if(!gyroAim.enabled)return;
   if(gyroAim.eventCount===0&&gyroAim.absCount===0&&gyroAim.motionCount===0)
     gyroDiag("ON • no orientation / absolute / motion events");
   else if(gyroAim.eventCount===0&&gyroAim.absCount===0&&gyroAim.motionCount>0)
     gyroDiag("MOTION only • events "+gyroAim.motionCount);
 },2200);
}
async function toggleGyroAim(){
 if(gyroAim.enabled){
   gyroAim.enabled=false;clearTimeout(gyroAim.probe);removeGyroListeners();
   gyroAimLabel();gyroDiag("OFF");return;
 }
 gyroDiag("requesting iOS permission…");
 try{
   let orientOK=true, motionOK=true;
   if(typeof DeviceOrientationEvent!=="undefined" &&
      typeof DeviceOrientationEvent.requestPermission==="function"){
     const p=await DeviceOrientationEvent.requestPermission();
     orientOK=(p==="granted");
     if(!orientOK){gyroDiag("orientation permission: "+p);}
   }
   if(typeof DeviceMotionEvent!=="undefined" &&
      typeof DeviceMotionEvent.requestPermission==="function"){
     const p2=await DeviceMotionEvent.requestPermission();
     motionOK=(p2==="granted");
   }
   if(!orientOK && !motionOK){
     gyroDiag("permission denied"); return;
   }
   startGyroListeners();
 }catch(e){
   gyroAim.enabled=false;gyroAimLabel();
   gyroDiag("ERROR • "+(e&&e.name?e.name:"unknown")+" "+(e&&e.message?e.message:""));
 }
}

