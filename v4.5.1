function pcslZoneAt(shotX,shotY){
 const info=targetInfo(), cx=target.x+scopeAim.x, cy=target.y+scopeAim.y;
 const w=Math.max(8,Math.min(c.width*.75,(info.w/target.range)*1000*scenePPM()));
 const h=Math.max(10,Math.min(c.height*.75,(info.h/target.range)*1000*scenePPM()));
 const nx=(shotX-cx)/w, ny=(shotY-cy)/h;
 // Outer D silhouette.
 let outer=false;
 if(ny>=-.50&&ny<=-.25) outer=Math.abs(nx)<=.17;
 else if(ny>-.25&&ny<=-.17) outer=Math.abs(nx)<=.50-(.50-.45)*((-.17-ny)/.08);
 else if(ny>-.17&&ny<=.12) outer=Math.abs(nx)<=.50;
 else if(ny>.12&&ny<=.50) outer=Math.abs(nx)<=.50-(.50-.18)*((ny-.12)/.38);
 if(!outer)return "M";
 // K: central head K-zone, approx official 4in top / 2.5in bottom / 5in high.
 if(ny>=-.455&&ny<=-.242){
   const t=(ny+.455)/.213;
   const half=t<.35 ? .114 : (.114-(.114-.071)*Math.min(1,(t-.35)/.30));
   if(Math.abs(nx)<=Math.max(.071,half))return "K";
 }
 // A: central body zone, 6in upper width, tapered to official lower A.
 if(ny>=-.25&&ny<=.285){
   let half=.171;
   if(ny>.08)half=.171-(.171-.105)*((ny-.08)/.205);
   if(Math.abs(nx)<=half)return "A";
 }
 // C: inner surrounding zone, approx official 11.75in width, tapered lower.
 if(ny>=-.25&&ny<=.36){
   let half=.336;
   if(ny>.02)half=.336-(.336-.138)*((ny-.02)/.34);
   if(Math.abs(nx)<=half)return "C";
 }
 return "D";
}
function currentTargetHitAt(shotX,shotY){
 const info=targetInfo();
 if(target.type==="pcsl") return pcslZoneAt(shotX,shotY)!=="M";
 const cx=target.x+scopeAim.x, cy=target.y+scopeAim.y;

 // Match hit geometry to the exact displayed target dimensions.
 const wMil=(info.w/target.range)*1000, hMil=(info.h/target.range)*1000;
 const wPx=Math.max(4,Math.min(c.width*.75,wMil*scenePPM()));
 const hPx=Math.max(4,Math.min(c.height*.75,hMil*scenePPM()));

 const lx=shotX-cx, ly=shotY-cy;
 const dx=Math.abs(lx);

 if(target.type==="circle"){
   return Math.hypot(lx,ly)<=wPx/2;
 }

 if(target.type==="body1m"){
   const top=-hPx/2, bottom=hPx/2;
   const headW=wPx*.34, headH=hPx*.26, shoulderY=top+hPx*.31;

   const inHead=(ly>=top && ly<=top+headH && dx<=headW/2);
   const inNeck=(ly>top+headH && ly<shoulderY && dx<=headW/2);

   let halfW=0;
   if(ly>=shoulderY && ly<=shoulderY+hPx*.07){
     const t=(ly-shoulderY)/(hPx*.07);
     halfW=wPx*(.32 + (.50-.32)*Math.max(0,Math.min(1,t)));
   }else if(ly>shoulderY+hPx*.07 && ly<=bottom){
     halfW=wPx/2;
   }
   const inBody=halfW>0 && dx<=halfW;
   return inHead||inNeck||inBody;
 }

 if(target.type==="head12"){
   const totalM=.50, shoulderM=.3048;
   const top=-hPx/2, bottom=hPx/2;
   const shoulderY=top+hPx*(shoulderM/totalM);
   const headW=wPx*.34, headH=(shoulderY-top)*.72;

   const inHead=(ly>=top && ly<=top+headH && dx<=headW/2);
   const inNeck=(ly>top+headH && ly<shoulderY && dx<=headW/2);

   let halfW=0;
   if(ly>=shoulderY && ly<=shoulderY+hPx*.05){
     const t=(ly-shoulderY)/(hPx*.05);
     halfW=wPx*(.32 + (.50-.32)*Math.max(0,Math.min(1,t)));
   }else if(ly>shoulderY+hPx*.05 && ly<=bottom){
     halfW=wPx/2;
   }
   const inBody=halfW>0 && dx<=halfW;
   return inHead||inNeck||inBody;
 }

 if(target.type==="torso"){
   return (Math.abs(lx)/(wPx/2) + Math.abs(ly)/(hPx/2)) <= 1;
 }

 return dx<=wPx/2 && Math.abs(ly)<=hPx/2;
}
function referenceRangeLimits(){
 const d=rows();
 if(!d.length)return {min:1,max:5000};
 return {min:d[0].x,max:d[d.length-1].x};
}
function effectiveAppearanceRange(){
 const lim=referenceRangeLimits();
 let min=Math.max(1,Number($("minRange").value)||lim.min);
 let max=Math.max(min,Number($("maxRange").value)||lim.max);
 min=Math.max(min,lim.min); max=Math.min(max,lim.max);
 if(max<min)min=max;
 return {min,max,tableMin:lim.min,tableMax:lim.max};
}
function randomTarget(){
 if(isPCSL()){
   if(!pcsl.live)return;
   pcsl.courseIndex=(pcsl.courseIndex+1)%20;
   pcslApplyCourse();
