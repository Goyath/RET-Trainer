function switchGunProfile(){
  if(!SWISSP_PROFILE_ROWS) SWISSP_PROFILE_ROWS=currentTableRows().filter(r=>Number(r[0])<=800);
  const val=$("gunProfile").value;
  activeCustomKey=null;

  if(val==="swissp"){
    setReferenceRows(SWISSP_PROFILE_ROWS.filter(r=>Number(r[0])<=800));
    $("gunProfileInfo").textContent="Swiss P 165gr";
    showCustomPanel(false);
  } else if(val==="556_nas3_805_13"){
    setReferenceRows(PROFILE_556_NAS3_805_13.filter(r=>Number(r[0])<=800));
    $("gunProfileInfo").textContent="5.56mm 80.5gr NAS3 13in • user-supplied reference data • 100–800m";
    showCustomPanel(false);
  } else if(val==="300wm_220_26"){
    setReferenceRows(PROFILE_338_250_26.filter(r=>Number(r[0])<=800));
    $("gunProfileInfo").textContent="300WM 220gr 26in • copied reference values from FULL .338 250gr 26in • 100–800m";
    showCustomPanel(false);
  } else if(val==="556_15_25"){
    setReferenceRows(PROFILE_556_15_25);
    $("gunProfileInfo").textContent="5.56mm 1.5in 25mZero • Sight Height 82.00mm • user-supplied reference data • 25–600m";
    showCustomPanel(false);
  } else if(val==="556_15_50"){
    setReferenceRows(PROFILE_556_15_50);
    $("gunProfileInfo").textContent="5.56mm 1.5in 50mZero • Sight Height 82.00mm • user-supplied reference data • 25–600m";
    showCustomPanel(false);
  } else if(val==="556_226_25"){
    setReferenceRows(PROFILE_556_226_25);
    $("gunProfileInfo").textContent="5.56mm 2.26in 25mZero • Sight Height 101.30mm • user-supplied reference data • 25–600m";
    showCustomPanel(false);
  } else if(val==="556_226_50"){
    setReferenceRows(PROFILE_556_226_50);
    $("gunProfileInfo").textContent="5.56mm 2.26in 50mZero • Sight Height 101.30mm • user-supplied reference data • 25–600m";
    showCustomPanel(false);
  } else if(val==="556_hydra_25"){
    setReferenceRows(PROFILE_556_HYDRA_25);
    $("gunProfileInfo").textContent="5.56mm Hydra 25mZero • Sight Height 120.00mm • user-supplied reference data • 25–600m";
    showCustomPanel(false);
  } else if(val==="556_hydra_50"){
    setReferenceRows(PROFILE_556_HYDRA_50);
    $("gunProfileInfo").textContent="5.56mm Hydra 50mZero • Sight Height 120.00mm • user-supplied reference data • 25–600m";
    showCustomPanel(false);
  } else if(val==="custom_new"){
    clearReferenceRows();
    $("customProfileName").value="";
    $("customZeroSetting").value="100";
    $("gunProfileInfo").textContent="CUSTOM • enter a profile name, Zero Setting, and reference data (max 800m)";
    showCustomPanel(true);
  } else if(val.startsWith("custom:")){
    const key=val.slice(7), profiles=getCustomProfiles(), p=profiles[key];
    if(p){
      activeCustomKey=key;
      setReferenceRows((p.rows||[]).filter(r=>Number(r[0])<=800));
      $("customProfileName").value=p.name||key;
      $("customZeroSetting").value=p.zero||100;
      $("gunProfileInfo").textContent=(p.name||key)+" • Zero Setting: "+(p.zero||100)+"m";
      showCustomPanel(true);
    }
  }
  draw();
}

function makeCustomKey(name){
  return (name||"custom").trim().toLowerCase().replace(/[^a-z0-9ぁ-んァ-ン一-龥_-]+/gi,"_")+"_"+Date.now();
}

function saveCurrentCustom(){
  const name=$("customProfileName").value.trim();
  if(!name){ alert("Profile nameを入力してください。"); return; }
  const zero=Math.max(1,Number($("customZeroSetting").value)||100);
  const profiles=getCustomProfiles();
  const key=activeCustomKey||makeCustomKey(name);
  profiles[key]={name,zero,rows:currentTableRows().filter(r=>Number(r[0])<=800)};
  saveCustomProfiles(profiles);
  activeCustomKey=key;
  refreshGunProfileOptions("custom:"+key);
  $("gunProfileInfo").textContent=name+" • Zero Setting: "+zero+"m";
}

function renameCurrentCustom(){
  if(!activeCustomKey){ alert("保存済みCUSTOMを選択してください。"); return; }
  const name=$("customProfileName").value.trim();
  if(!name) return;
  const profiles=getCustomProfiles();
  if(profiles[activeCustomKey]){
    profiles[activeCustomKey].name=name;
    profiles[activeCustomKey].zero=Math.max(1,Number($("customZeroSetting").value)||100);
    profiles[activeCustomKey].rows=currentTableRows();
    saveCustomProfiles(profiles);
    refreshGunProfileOptions("custom:"+activeCustomKey);
    $("gunProfileInfo").textContent=name+" • Zero Setting: "+profiles[activeCustomKey].zero+"m";
  }
}

function deleteCurrentCustom(){
  if(!activeCustomKey){ alert("保存済みCUSTOMを選択してください。"); return; }
  const profiles=getCustomProfiles();
  delete profiles[activeCustomKey];
  saveCustomProfiles(profiles);
  activeCustomKey=null;
  refreshGunProfileOptions("swissp");
  switchGunProfile();
}
