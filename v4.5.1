function saveProfile(){
 try{
   const profile={
     version:"7.3",
     reticleDataURL,
     reticleScale,
     reticleImgOffset,
     reticleMode:$("reticleMode").value,
     opacity:$("opacity").value,
     backgroundDataURL,
     backgroundScale,
     backgroundOffset,
     table:tableData(),
     settings:{
       targetType:$("targetType").value,
       minZoom:$("minZoom").value,
       maxZoom:$("maxZoom").value,
       fp:$("fp").value,
       sfpCal:$("sfpCal").value,
       showLRF:$("showLRF").value,
       minRange:$("minRange").value,
       maxRange:$("maxRange").value,
       showDrop:$("showDrop").value,
       triggerFeedback:$("triggerFeedback").value,
       impactAudio:$("impactAudio").value,
       traceDisplay:$("traceDisplay").value,
       movingMode:$("movingMode").value,
       speedUnit:$("speedUnit").value,
       movingPath:$("movingPath").value,
       speedError:$("speedError").value,
       trainingRange:$("trainingRange").value,
       travelDistance:$("travelDistance").value,
       trainingSpeed:$("trainingSpeed").value
     }
   };
   localStorage.setItem("rangeReticleTrainerProfile",JSON.stringify(profile));
   $("saveStatus").textContent="保存しました。次回このHTMLを開いた時も LOAD SAVED で復元できます。";
 }catch(e){
   $("saveStatus").textContent="保存失敗: "+e.message+"（画像サイズが大きすぎる場合があります）";
 }
}
function loadProfile(){
 try{
   const raw=localStorage.getItem("rangeReticleTrainerProfile");
   if(!raw){$("saveStatus").textContent="保存済みデータがありません。";return}
   const p=JSON.parse(raw);
   reticleScale=+p.reticleScale||1;
   reticleImgOffset=p.reticleImgOffset||{x:0,y:0};
   reticleDataURL=p.reticleDataURL||"";
   $("scaleNumber").value=reticleScale.toFixed(2);
   $("reticleMode").value=p.reticleMode||"classic";
   $("opacity").value=p.opacity||90;
   if(reticleDataURL){
     const im=new Image();im.onload=()=>{reticle=im;drawCalib();draw()};im.src=reticleDataURL;
   }else reticle=null;

   backgroundScale=+p.backgroundScale||1;
   backgroundOffset=p.backgroundOffset||{x:0,y:0};
   $("backgroundScale").value=backgroundScale.toFixed(2);
   backgroundDataURL=p.backgroundDataURL||DEFAULT_BG;
   const bg=new Image();
   bg.onload=()=>{backgroundImg=bg;backgroundReady=true;draw()};
   bg.src=backgroundDataURL;

   $("body").innerHTML="";
   (p.table||[]).forEach(r=>addRow(r.range,r.drop,r.drift,r.tof));
   if(!(p.table||[]).length)sample();

   const st=p.settings||{};
   Object.keys(st).forEach(id=>{if($(id))$(id).value=st[id]});
   setZoom(zoom);
   drawCalib();draw();
   $("saveStatus").textContent="保存済みプロファイルを復元しました。";
 }catch(e){$("saveStatus").textContent="読込失敗: "+e.message}
}
function deleteProfile(){
 try{
   localStorage.removeItem("rangeReticleTrainerProfile");
   $("saveStatus").textContent="保存済みプロファイルを削除しました。";
 }catch(e){}
}
