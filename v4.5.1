function draw68MOA(){
 const cx=c.width/2, cy=c.height/2;

 // Convert angular size to the trainer's existing MIL pixel scale.
 // 1 MOA = 0.290888 mrad. A 68 MOA ring therefore has a 34 MOA radius.
 const pMil=reticlePPM();
 const radiusMil=34*0.290888;
 const radiusPx=radiusMil*pMil;
 const dotRadiusPx=Math.max(2,(0.5*0.290888)*pMil);

 ctx.save();
