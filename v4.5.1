function interp(x,k,d){
 if(d.length<2)return 0;
 if(x<=d[0].x){let p=d[0],n=d[1];return p[k]+(x-p.x)*(n[k]-p[k])/(n.x-p.x)}
 if(x>=d[d.length-1].x){let p=d[d.length-2],n=d[d.length-1];return p[k]+(x-p.x)*(n[k]-p[k])/(n.x-p.x)}
 for(let i=0;i<d.length-1;i++){let p=d[i],n=d[i+1];if(x>=p.x&&x<=n.x)return p[k]+(x-p.x)*(n[k]-p[k])/(n.x-p.x)}
 return 0;
}
function zeroReference(){
 const d=rows();
